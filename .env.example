# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"

# Database name (defaults to explainwhy_dev if unset)
MONGODB_DB="explainwhy_dev"

# --- Optional access controls (all default to "off") ---
# Simulator controls (/api/dev/*) are always available when NODE_ENV=development.
# To expose them in a deployed demo, set BOTH values and send header `x-explainwhy-demo-key: <EXPLAINWHY_DEMO_KEY>`.
# EXPLAINWHY_DEMO_MODE="true"
# EXPLAINWHY_DEMO_KEY="choose-a-long-random-secret"

# External connectors posting to POST /api/ingest/events outside development send
# `Authorization: Bearer <EXPLAINWHY_INGEST_API_KEY>`.
# EXPLAINWHY_INGEST_API_KEY="choose-another-long-random-secret"

# Direct monitoring is enabled in development. Set false to demonstrate Change Streams alone;
# set true in a deployed demo. Ready windows remain durable regardless of this flag.
# EXPLAINWHY_AUTO_MONITOR="true"
# Run the independent watcher with `npm run monitor:watch` (check Atlas first: `npm run monitor:check`).

# Stage 5 — server-side Mubit investigation; never expose these as NEXT_PUBLIC variables.
MUBIT_API_KEY=""
# OpenAI calls use this base; Gemini uses its own base and transport below.
MUBIT_BASE_URL="https://api.mubit.ai/openai/v1"
MUBIT_GEMINI_BASE_URL="https://api.mubit.ai/gemini"
# Both transports have console-verified Gemini training tasks. The optional "openai"
# transport uses Gemini's compatible endpoint; starter credit may restrict that route.
MUBIT_GEMINI_TRANSPORT="native"
MUBIT_INVESTIGATOR_MODEL="gemini-4-argon"
MUBIT_DIAGNOSIS_MODEL="gemini-4-argon"
MUBIT_PLANNER_MODEL="gemini-4-argon"
MUBIT_RESEARCH_MODEL="gemini-4-argon"

# Sponsor data integration: server-only Zetaris SQL API. H-MEM needs no account/key.
# Enable only after registering the two scoped CSV relations (see docs/sponsor-integrations/README.md).
EXPLAINWHY_ZETARIS_ENABLED="false"
ZETARIS_BASE_URL="http://127.0.0.1:8888"
ZETARIS_API_KEY=""
ZETARIS_ORG_ID=""
ZETARIS_ADS_RELATION=""
ZETARIS_CAMPAIGNS_RELATION=""
MUBIT_REASONING_DEPTH="low"
EXPLAINWHY_EXTERNAL_RESEARCH_ENABLED="false"
# Native search requires your Gemini provider key configured inside Mubit (not starter credit).
EXPLAINWHY_DIRECT_GEMINI_FALLBACK="false"
# GEMINI_API_KEY is used ONLY when explicit direct fallback is enabled.
# GEMINI_API_KEY=""
EXPLAINWHY_INVESTIGATION_MAX_ROUNDS="5"
EXPLAINWHY_INVESTIGATION_MAX_TOKENS="180000"
EXPLAINWHY_INVESTIGATION_TIMEOUT_MS="600000"
# Optional conservative cost cap requires both operator-supplied rates and research disabled.
# EXPLAINWHY_INPUT_USD_PER_MILLION=""
# EXPLAINWHY_OUTPUT_USD_PER_MILLION=""
# EXPLAINWHY_INVESTIGATION_MAX_COST_USD=""
# Start durable work separately: npm run investigator:work

# Model provider. "nvidia" calls the NVIDIA API catalog directly with NVIDIA_API_KEY (no Mubit key needed);
# "mubit" (default) keeps the original Gemini-through-Mubit route used by the earlier recorded runs.
EXPLAINWHY_MODEL_PROVIDER="mubit"
# With EXPLAINWHY_MODEL_PROVIDER="nvidia" every stage defaults to nvidia/nemotron-3-super-120b-a12b. Override per stage:
# NEMOTRON_INVESTIGATOR_MODEL=""
# NEMOTRON_DIAGNOSIS_MODEL=""
# NEMOTRON_PLANNER_MODEL=""
# Structured output on NVIDIA: json_schema (response_format), guided_json (NIM nvext) or prompt (schema in prompt).
# NVIDIA_STRUCTURED_OUTPUT="json_schema"
# Grounded external research needs Gemini and is unavailable on the NVIDIA route.

# Independent Nemotron verification of each diagnosis (NVIDIA API catalog, build.nvidia.com). Server-only.
# It never edits the diagnosis; disagreement is flagged for review. Set the reward model to "off" to skip scoring.
EXPLAINWHY_NEMOTRON_VERIFIER="false"
NVIDIA_API_KEY=""
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NEMOTRON_JUDGE_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"
# NEMOTRON_REWARD_MODEL="nvidia/nemotron-4-340b-reward"
