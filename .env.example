# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Auth + Data API) — publishable key is safe for NEXT_PUBLIC_* in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only (API routes, workers). Never expose as NEXT_PUBLIC_*.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Application database: Supabase Postgres via the pooler. Copy the exact host from Supabase > Connect.
# Percent-encode special characters in the password. DIRECT_URL is used by Prisma migrations only.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# Postgres schema holding the app's collections (one table per collection).
DATABASE_SCHEMA="explainwhy_dev"

# NVIDIA API catalog (primary inference: investigation, diagnosis, planning)
EXPLAINWHY_MODEL_PROVIDER="nvidia"
NVIDIA_API_KEY=""
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# Local Nemotron on the same Mac: choose local mode, a loopback /v1 endpoint,
# and a model actually installed in Ollama or LM Studio. No cloud key is needed.
NVIDIA_INFERENCE_MODE="cloud"
# NVIDIA_INFERENCE_MODE="local"
# NVIDIA_BASE_URL="http://127.0.0.1:11434/v1"
# NVIDIA_LOCAL_MODEL="nemotron-3-nano:4b"
# NVIDIA_LOCAL_API_KEY="" # Only if your local server requires authentication.
# NEMOTRON_INVESTIGATOR_MODEL="nvidia/nemotron-3-super-120b-a12b"
# NEMOTRON_DIAGNOSIS_MODEL=""
# NEMOTRON_PLANNER_MODEL=""
# NVIDIA_STRUCTURED_OUTPUT="json_schema"
EXPLAINWHY_REASONING_DEPTH="low"

# Optional grounded public research (direct Gemini, not NVIDIA)
EXPLAINWHY_EXTERNAL_RESEARCH_ENABLED="false"
EXPLAINWHY_RESEARCH_PROVIDER="gemini"
# To use Bright Data instead of Gemini search:
# EXPLAINWHY_EXTERNAL_RESEARCH_ENABLED="true"
# EXPLAINWHY_RESEARCH_PROVIDER="brightdata"
BRIGHTDATA_API_KEY=""
BRIGHTDATA_SERP_ZONE=""
# GEMINI_API_KEY=""
# GEMINI_RESEARCH_MODEL="gemini-2.0-flash"

EXPLAINWHY_ZETARIS_ENABLED="false"
ZETARIS_BASE_URL="http://127.0.0.1:8888"
ZETARIS_API_KEY=""
ZETARIS_ORG_ID=""
ZETARIS_ADS_RELATION=""
ZETARIS_CAMPAIGNS_RELATION=""

# Both ExplainWhy and Animation Studio run on your friend's Mac.
EXPLAINWHY_ANIMATION_ENABLED="false"
ANIMATION_STUDIO_BASE_URL="http://127.0.0.1:8765"

EXPLAINWHY_INVESTIGATION_MAX_ROUNDS="5"
EXPLAINWHY_INVESTIGATION_MAX_TOKENS="180000"
EXPLAINWHY_INVESTIGATION_TIMEOUT_MS="600000"

EXPLAINWHY_NEMOTRON_VERIFIER="false"
# NEMOTRON_JUDGE_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"
# NEMOTRON_REWARD_MODEL="nvidia/nemotron-4-340b-reward"

# Hosted demo: unlock dashboard + /api/dev/* without NODE_ENV=development.
# Set both on the server; middleware attaches x-explainwhy-demo-key to /api requests.
EXPLAINWHY_DEMO_MODE="false"
EXPLAINWHY_DEMO_KEY=""
# Optional: browser E2E / curl only — prefer middleware for public demos (do not use NEXT_PUBLIC_* for the key).
# E2E_DEMO_KEY=""
