{
  "name": "open-agent-2026-explainwhy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contracts:typecheck": "npm run typecheck -w @explainwhy/contracts",
    "contracts:validate": "npm run validate -w @explainwhy/contracts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:analysis": "node scripts/dev-with-analysis.mjs",
    "analysis:watch": "node --conditions=react-server --import tsx scripts/dashboard-analysis-worker.ts",
    "monitor:watch": "node --conditions=react-server --import tsx scripts/monitor-watch.ts",
    "monitor:check": "node --conditions=react-server --import tsx scripts/monitor-watch.ts --check",
    "verify": "npm run contracts:typecheck && npm run contracts:validate && npm run typecheck && npm run lint && npm run test",
    "demo:stage4": "node --conditions=react-server --import tsx scripts/demo-stage4.ts",
    "investigator:work": "node --conditions=react-server --import tsx scripts/investigator-worker.ts",
    "planner:work": "node --conditions=react-server --import tsx scripts/planner-worker.ts",
    "investigator:check": "node --conditions=react-server --import tsx scripts/check-models.ts",
    "sponsors:check": "node --conditions=react-server --import tsx scripts/check-sponsor-integrations.ts",
    "meterless:backfill": "node --conditions=react-server --import tsx scripts/backfill-meterless.ts",
    "zetaris:prepare": "python3 scripts/setup-zetaris.py",
    "zetaris:start": "python3 scripts/setup-zetaris.py --start",
    "zetaris:export": "node --conditions=react-server --import tsx scripts/export-zetaris.ts",
    "research:check": "node --conditions=react-server --import tsx scripts/check-research.ts",
    "training:source": "node --conditions=react-server --import tsx scripts/train-source-support.ts",
    "demo:stage5": "node --conditions=react-server --import tsx scripts/demo-stage5.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:migrate-mongo": "node --conditions=react-server --import tsx scripts/migrate-mongo-to-supabase.ts",
    "cf:build": "EXPLAINWHY_CF_BUILD=true opennextjs-cloudflare build",
    "cf:preview": "EXPLAINWHY_CF_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "EXPLAINWHY_CF_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "integrations:preflight": "node --conditions=react-server --import tsx scripts/check-friend-mac.ts",
    "animation:smoke": "node --conditions=react-server --import tsx scripts/smoke-financial-animation.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/client": "^6.19.2",
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "mingo": "^7.2.6",
    "mongodb": "^7.7.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
